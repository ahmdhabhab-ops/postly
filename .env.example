# In Dokploy paste these in the Environment tab. Locally: cp .env.example .env (never commit .env).
# --- required ---
DB_PASSWORD=                      # long random string (database password)
# --- accounts: who may send WhatsApp messages from the business number (comma separated) ---
ADMIN_EMAILS=you@example.com      # register with this email in Postly to get WhatsApp sending
# --- WhatsApp Cloud API (optional until you have Meta credentials) ---
WHATSAPP_ACCESS_TOKEN=            # Meta permanent (system user) access token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=              # used to verify webhook signatures
WHATSAPP_VERIFY_TOKEN=            # any random string; same value in Meta webhook setup
WHATSAPP_GRAPH_VERSION=v21.0
ADMIN_API_KEY=                    # optional: server-to-server key for X-API-Key on /api/whatsapp/send
# --- AI assistant (optional; without it the assistant uses simple built-in replies) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# --- advanced ---
# TRUST_PROXY_HOPS=2              # Traefik + nginx in front of the API
# SESSION_DAYS=14
