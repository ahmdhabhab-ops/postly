# Copy to .env (never commit .env). Server-side only.
WHATSAPP_ACCESS_TOKEN=            # Meta permanent (system user) access token
WHATSAPP_PHONE_NUMBER_ID=         # WhatsApp Business phone number ID
WHATSAPP_APP_SECRET=              # Meta App secret, used to verify webhook signatures
WHATSAPP_VERIFY_TOKEN=            # any random string; paste the same value in Meta webhook setup
ADMIN_API_KEY=                    # long random string required in X-API-Key for send endpoints
WHATSAPP_GRAPH_VERSION=v21.0
# CORS_ORIGIN=https://postly.media   # only if the frontend is served from another origin
